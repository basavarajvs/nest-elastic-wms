  ISSUE
  ADJUSTMENT
  TRANSFER
  RETURN
  PHYSICAL_COUNT
  CYCLE_COUNT
  SPOT_CHECK
  WRITE_OFF
  RESERVATION
  ALLOCATION
  DEALLOCATION
  PICK
  PUTAWAY
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_IN
  TRANSFER_OUT
  QUARANTINE
  SCRAP

  @@schema("multitenant")
}

enum variance_reason {
  COUNT_ERROR
  SYSTEM_ERROR
  PHYSICAL_DAMAGE
  THEFT
  RECEIVING_ERROR
  PICKING_ERROR
  PUTAWAY_ERROR
  TRANSACTION_ERROR
  LOCATION_ERROR
  PRODUCT_MIX
  UNIT_OF_MEASURE_ERROR
  EXPIRATION
  QUALITY_HOLD
  OTHER

  @@schema("multitenant")
}

enum zone_type {
  BULK
  RACK
  COLD_STORAGE
  HAZMAT
  PICKING
  RECEIVING
  SHIPPING
  PACKING
  QUALITY_HOLD
  DAMAGE
  TEMPORARY
  YARD
  RETURNS

  @@schema("multitenant")
}

/// Count scheduler run metrics (GAP-6.4)
model count_scheduler_metrics {
  metric_id              BigInt   @id @default(autoincrement())
  tenant_id              String   @db.Uuid
  facility_id            BigInt
  schedule_run_at        DateTime @default(now()) @db.Timestamptz(6)
  total_counts_created   Int      @default(0)
  a_items_created        Int      @default(0)
  b_items_created        Int      @default(0)
  c_items_created        Int      @default(0)
  errors_count           Int      @default(0)
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, facility_id], map: "idx_csm_tenant_facility")
  @@schema("multitenant")
}

/// Immutable cycle count audit trail (APP-CC-E)
model cycle_count_events {
  event_id        BigInt   @id @default(autoincrement())
  tenant_id       String   @db.Uuid
  facility_id     BigInt
  count_id        BigInt
  event_type      String   @db.VarChar(50)
  event_data      String?
  performed_by    String?  @db.Uuid
  performed_at    DateTime @default(now()) @db.Timestamptz(6)
  snapshot        String?

  @@index([count_id], map: "idx_cce_count")
  @@index([tenant_id, facility_id], map: "idx_cce_tenant_facility")
  @@schema("multitenant")
}

/// ABC reclassification log (APP-CC-J)
model abc_reclassification_log {
  log_id           BigInt   @id @default(autoincrement())
  tenant_id        String   @db.Uuid
  product_id       BigInt
  old_class        String   @db.Char(1)
  new_class        String   @db.Char(1)
  old_frequency    Int?
  new_frequency    Int?
  reason           String?
  reclassified_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([product_id], map: "idx_abcr_product")
  @@schema("multitenant")
}

/// Tote-to-shelf assignments for cluster picking (GAP-1.2)
model pick_cart_assignments {
  assignment_id     BigInt   @id @default(autoincrement())
  tenant_id         String   @db.Uuid
  cart_id           BigInt
  shelf_position    String   @db.VarChar(20)
  tote_lpn_id       BigInt?
  tote_barcode      String?  @db.VarChar(100)
  assignment_order  Int?
  session_id        BigInt?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@schema("multitenant")
}

/// Route optimization sequence records (GAP-5.2)
model pick_routes {
  route_id               BigInt    @id @default(autoincrement())
  tenant_id              String    @db.Uuid
  wave_id                BigInt
  picker_id              String?   @db.Uuid
  sequence_order         Int
  task_id                BigInt
  location_id            BigInt
  estimated_travel_distance Decimal? @db.Decimal(10, 2)
  actual_start_time      DateTime? @db.Timestamptz(6)
  actual_end_time        DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)

  @@schema("multitenant")
}

/// Batch picking sessions (GAP-2.2)
model pick_batch_sessions {
  batch_id     BigInt   @id @default(autoincrement())
  tenant_id    String   @db.Uuid
  wave_id      BigInt
  status       String   @default("CREATED") @db.VarChar(20)
  created_by   String?  @db.Uuid
  updated_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@schema("multitenant")
}

/// Cluster pick task grouping (GAP-1)
model cluster_pick_groups {
  group_id         BigInt   @id @default(autoincrement())
  tenant_id        String   @db.Uuid
  session_id       BigInt   @unique
  cart_id          BigInt
  wave_id          BigInt?
  status           String   @default("ACTIVE") @db.VarChar(20)
  picker_id        String?  @db.Uuid
  total_tasks      Int?     @default(0)
  completed_tasks  Int?     @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  completed_at     DateTime? @db.Timestamptz(6)

  @@schema("multitenant")
}

/// Immutable pick audit trail (APP-PICK-J)
model pick_audit_log {
  audit_id       BigInt   @id @default(autoincrement())
  tenant_id      String   @db.Uuid
  task_id        BigInt
  from_location_id BigInt?
  to_lpn_id      BigInt?
  to_tote_id     BigInt?
  product_id     BigInt?
  qty_picked     Decimal? @db.Decimal(12, 4)
  qty_remaining  Decimal? @db.Decimal(12, 4)
  event_type     String   @db.VarChar(50)
  notes          String?
  recorded_by    String?  @db.Uuid
  recorded_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([task_id], map: "idx_pal_task")
  @@schema("multitenant")
}

/// Short pick reason codes (APP-PICK-E)
model short_pick_reasons {
  reason_id              BigInt   @id @default(autoincrement())
  tenant_id              String   @db.Uuid
  reason_code            String   @db.VarChar(50)
  description            String?
  triggers_recount       Boolean? @default(false)
  triggers_investigation Boolean? @default(false)
  is_active              Boolean? @default(true)
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenant_id, reason_code])
  @@schema("multitenant")
}

/// Batch sortation sessions (APP-PICK-K)
model batch_sortation_sessions {
  sortation_id BigInt   @id @default(autoincrement())
  tenant_id    String   @db.Uuid
  batch_id     BigInt
  status       String   @default("PENDING") @db.VarChar(20)
  total_items  Int?     @default(0)
  sorted_items Int?     @default(0)
  created_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)

  @@index([tenant_id, batch_id], map: "idx_bss_batch")
  @@index([tenant_id, status], map: "idx_bss_status")
  @@schema("multitenant")
}
