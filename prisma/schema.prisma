/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model adjustment_approval_requests {
  request_id          BigInt          @id @default(autoincrement())
  tenant_id           String          @db.VarChar(255)
  facility_id         BigInt
  count_id            BigInt
  count_number        String?         @db.VarChar(100)
  product_id          BigInt
  product_sku         String?         @db.VarChar(100)
  product_name        String?         @db.VarChar(255)
  location_id         BigInt?
  location_code       String?         @db.VarChar(50)
  system_quantity     Decimal?        @default(0) @db.Decimal(12, 4)
  counted_quantity    Decimal?        @default(0) @db.Decimal(12, 4)
  variance_quantity   Decimal?        @default(0) @db.Decimal(12, 4)
  variance_percentage Decimal?        @default(0) @db.Decimal(7, 2)
  variance_value      Decimal?        @default(0) @db.Decimal(12, 2)
  approval_level      approval_level
  status              approval_status @default(PENDING)
  priority            String?         @db.VarChar(20)
  requested_by        BigInt?
  requested_by_name   String?         @db.VarChar(255)
  requested_at        DateTime        @db.Timestamp(6)
  assigned_to         BigInt?
  assigned_to_name    String?         @db.VarChar(255)
  assigned_at         DateTime?       @db.Timestamp(6)
  reviewed_by         BigInt?
  reviewed_by_name    String?         @db.VarChar(255)
  reviewed_at         DateTime?       @db.Timestamp(6)
  approval_comments   String?
  rejection_reason    String?
  days_pending        Int?
  created_at          DateTime?       @default(now()) @db.Timestamp(6)
  created_by          String?         @db.VarChar(255)
  updated_at          DateTime?       @default(now()) @db.Timestamp(6)
  updated_by          String?         @db.VarChar(255)
  version             Int?            @default(0)

  @@index([assigned_to], map: "idx_aar_assigned")
  @@index([count_id], map: "idx_aar_count")
  @@index([created_at], map: "idx_aar_created")
  @@index([approval_level], map: "idx_aar_level")
  @@index([priority], map: "idx_aar_priority")
  @@index([requested_at], map: "idx_aar_requested_at")
  @@index([status], map: "idx_aar_status")
  @@index([tenant_id, facility_id], map: "idx_aar_tenant_facility")
  @@schema("multitenant")
}

